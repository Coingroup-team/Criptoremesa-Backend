{
  "name": "coingroup-template-server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "build": "babel src --out-dir dist",
    "dev:api": "nodemon --signal SIGTERM --exec babel-node src/index.js",
    "dev:rem": "babel-node src/utils/workers/createRemittance.worker.js",
    "dev:silt": "babel-node src/utils/workers/silt.worker.js",
    "dev:persona": "babel-node src/utils/workers/persona.worker.js",
    "start:api": "babel-node src/index.js",
    "start:rem": "babel-node src/utils/workers/createRemittance.worker.js",
    "start:silt": "babel-node src/utils/workers/silt.worker.js",
    "start:persona": "babel-node src/utils/workers/persona.worker.js",
    "start:all": "concurrently \"npm run start:api\" \"npm run start:rem\" \"npm run start:silt\" \"npm run start:persona\" --names \"API,REM,SILT,PERSONA\" --prefix-colors \"blue,green,yellow,magenta\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisRFuentes54/coingroup-backend-template.git"
  },
  "keywords": [
    "js",
    "express"
  ],
  "contributors": [
    "Luis Fuentes <luisrf0540@gmail.com>",
    "Stephanie Cruz <stephaniecruzcastelli@gmail.com>",
    "Anthony Rodriguez <agrodriguez.17@est.ucab.edu.ve>",
    "Gregg Spinetti <gmspinetti17@est.ucab.edu.ve>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/LuisRFuentes54/coingroup-backend-template/issues"
  },
  "homepage": "https://github.com/LuisRFuentes54/coingroup-backend-template#readme",
  "dependencies": {
    "@bull-board/express": "^5.23.0",
    "@sentry/node": "^8.19.0",
    "@sentry/profiling-node": "^8.19.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^6.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-and-time": "^1.0.0",
    "express": "^4.21.2",
    "express-promise-router": "^4.0.1",
    "express-queue": "^0.0.13",
    "express-session": "^1.19.0",
    "formidable": "^1.2.2",
    "google-spreadsheet": "^3.1.15",
    "helmet": "^4.4.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "multicoin-address-validator": "^0.5.26",
    "node-cron": "^3.0.2",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "redis": "^3.1.2",
    "request-ip": "^3.3.0",
    "socket.io": "^4.8.3",
    "transbank-sdk": "^4.0.0",
    "twilio": "^5.13.1",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.2",
    "concurrently": "^9.2.1",
    "dotenv": "^8.2.0",
    "nodemon": "^3.1.14"
  }
}
